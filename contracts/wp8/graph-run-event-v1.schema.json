  "$id": "metarec:wp8/graph-run-event-v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "graph_start"
          }
        },
        "required": [
          "event_type"
        ]
      },
      "then": {
        "properties": {
          "duration_ms": {
            "type": "null"
          },
          "graph_instance_id": {
            "not": {
              "type": "null"
            }
          },
          "node_id": {
            "type": "null"
          },
          "run_id": {
            "not": {
              "type": "null"
            }
          },
          "runnable_type": {
            "enum": [
              "graph"
            ]
          },
          "state_diff": {
            "type": "null"
          },
          "status": {
            "const": "running"
          }
        }
      }
    },
    {
